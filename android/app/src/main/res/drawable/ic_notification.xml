<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar/notification-shade icon. Android ignores color on these and
     renders only the shape's alpha channel as a flat white silhouette (API
     21+), so the full-color gradient LogoMark (see components/Logo.tsx)
     would just come out as a white blob here — this is a deliberately
     simplified single glyph (the "AI spark" from the logo) instead, sized
     and shaped to stay legible at the tiny sizes the status bar renders
     icons at. android:tint forces it white regardless of fillColor, so the
     path itself just needs to be a solid, unambiguous shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,1.5 L14.3,9.2 22,11.5 14.3,13.8 12,21.5 9.7,13.8 2,11.5 9.7,9.2 Z"/>
</vector>
