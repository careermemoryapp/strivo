<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link used to hand a completed Google sign-in back from
                 the system browser into this app (see /api/auth/mobile-bridge
                 and MainActivity's handleAuthCallbackIntent). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ai.strivo.app" android:host="auth-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Icon FCM falls back to for notifications that don't specify
             their own (all of ours, for now — see lib/push.ts). Points at
             the simplified white silhouette in res/drawable/ic_notification.xml,
             not the full-color app icon — Android flattens status-bar
             icons to a plain white shape regardless, so using the launcher
             icon there renders as an illegible white blob instead of the
             actual logo. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ requires this permission to be declared (and granted
         at runtime — see usePushRegistration.ts) before any notification,
         including FCM push, can be shown in the notification bar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice-to-text recording (Web Speech API / getUserMedia in the web
         app) needs the mic. Capacitor's Bridge already has the runtime
         permission-request flow wired up for this out of the box
         (BridgeWebChromeClient.onPermissionRequest grants RECORD_AUDIO when
         the web page asks for microphone access) — the only piece that was
         actually missing was declaring the permission here so Android will
         let that grant happen at all. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- @capawesome/capacitor-file-picker (see Resume upload / Record's
         Upload tab): replaces the old <input type="file"> + WebView
         file-chooser bridge, which was silently dropping selected files
         app-wide (picker opens, user picks a file, nothing happens -- no
         error, no upload). Picking a file itself needs no runtime
         permission (the OS presents the picker on the app's behalf) --
         these two are only for optional extras the plugin supports
         (unredacted photo EXIF location, and reading files from legacy
         external storage on older Android versions). Harmless to declare
         even though this app doesn't use either extra. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
</manifest>
