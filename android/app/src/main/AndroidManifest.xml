<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link used to hand a completed Google sign-in back from
                 the system browser into this app (see /api/auth/mobile-bridge
                 and MainActivity's handleAuthCallbackIntent). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ai.strivo.app" android:host="auth-callback" />
            </intent-filter>

            <!-- Android App Links: makes a plain https://strivo.ai/... link
                 (e.g. tapped from the Product Updates drip email, see
                 emailProductUpdate.ts) open THIS APP directly instead of the
                 phone's browser, for anyone who already has it installed.
                 autoVerify="true" tells Android to check, at install time,
                 that this app is genuinely authorized to handle strivo.ai
                 links by fetching https://strivo.ai/.well-known/assetlinks.json
                 and matching this app's signing certificate against it (see
                 that file's own comment, and MainActivity's
                 handleAppLinkIntent for what happens once the link lands
                 here).

                 IMPORTANT: scoped to only the specific paths real emails
                 link to (/blog, /record, /memories, /chats, /home; see
                 BLOG_CTA_PATHS in repo/blogPosts.ts), NOT the whole host.
                 An earlier version of this filter covered all of
                 https://strivo.ai/*, which broke Google Sign-In for every
                 user once verification finished propagating: the sign-in
                 flow opens the system browser to /mobile-google-start,
                 Google eventually redirects that browser tab to
                 https://strivo.ai/api/auth/callback/google, and once this
                 app is a verified handler for strivo.ai, Android hijacks
                 that in-browser redirect into this app's own WebView mid
                 OAuth flow; a different cookie jar than the browser tab
                 that started the flow, so NextAuth's state-cookie check
                 fails and the user just bounces back to the login screen,
                 for every account, every time. Scoping to specific paths
                 keeps the email-deep-link feature working while leaving
                 /api/auth/*, /mobile-google-start, and /login alone so
                 they're never eligible for this interception. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="strivo.ai" android:pathPrefix="/blog" />
                <data android:scheme="https" android:host="strivo.ai" android:pathPrefix="/record" />
                <data android:scheme="https" android:host="strivo.ai" android:pathPrefix="/memories" />
                <data android:scheme="https" android:host="strivo.ai" android:pathPrefix="/chats" />
                <data android:scheme="https" android:host="strivo.ai" android:pathPrefix="/home" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Icon FCM falls back to for notifications that don't specify
             their own (all of ours, for now — see lib/push.ts). Points at
             the simplified white silhouette in res/drawable/ic_notification.xml,
             not the full-color app icon — Android flattens status-bar
             icons to a plain white shape regardless, so using the launcher
             icon there renders as an illegible white blob instead of the
             actual logo. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Singular MMP SDK (src/lib/singular.ts): needed for install/session
         attribution. Singular's Cordova plugin normally injects these two
         via config.xml's <edit-config>, but that mechanism is Cordova-only
         and Capacitor's `cap sync` doesn't run it, so they're declared here
         by hand instead. ACCESS_NETWORK_STATE lets the SDK check connectivity
         before sending attribution events; AD_ID is required on Android 13+
         to read the advertising ID Singular uses for attribution matching
         (Strivo is not a kids' app, so this is required, not omitted). The
         third permission the plugin needs, BIND_GET_INSTALL_REFERRER_SERVICE,
         doesn't go here; it ships inside the Play Install Referrer
         library's own manifest and merges in automatically once that
         library is pulled in as a Gradle dependency (via `npx cap sync`
         after installing singular_cordova_sdk). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Android 13+ requires this permission to be declared (and granted
         at runtime — see usePushRegistration.ts) before any notification,
         including FCM push, can be shown in the notification bar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice-to-text recording (Web Speech API / getUserMedia in the web
         app) needs the mic. Capacitor's Bridge already has the runtime
         permission-request flow wired up for this out of the box
         (BridgeWebChromeClient.onPermissionRequest grants RECORD_AUDIO when
         the web page asks for microphone access) — the only piece that was
         actually missing was declaring the permission here so Android will
         let that grant happen at all. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- @capawesome/capacitor-file-picker (see Resume upload / Record's
         Upload tab): replaces the old <input type="file"> + WebView
         file-chooser bridge, which was silently dropping selected files
         app-wide (picker opens, user picks a file, nothing happens, no
         error, no upload). Picking a file itself needs no runtime
         permission (the OS presents the picker on the app's behalf);
         these two are only for optional extras the plugin supports
         (unredacted photo EXIF location, and reading files from legacy
         external storage on older Android versions). Harmless to declare
         even though this app doesn't use either extra. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
</manifest>
