# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-build/
/.next-previous-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/

# rollback bookkeeping -- written by scripts/deploy.sh on the server, local
# to whichever machine deployed, never meant to be committed
.last-known-good

# npm audit snapshot -- written by scripts/deploy.sh on every deploy, read
# by the admin dashboard's Security status panel. Server-generated data,
# not source, and would go stale the moment it's committed.
security-audit.json

# Live security check snapshot -- written by scripts/live-security-check.js
# via cron, read by the admin dashboard's Live security checks panel.
# Server-generated data, not source.
live-security-status.json
